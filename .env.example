# Copy to .env.local for local dev. NEVER commit .env or .env.local.
# See docs/summit-mvp-architecture.md §11 for what each var does.

# Base path when publishing under a subpath. Empty for root deploys.
BASE_PATH=

# Which environment this build represents ("dev" | "prod"). Drives noindex etc.
NEXT_PUBLIC_ENVIRONMENT=dev

# Public site URL, used for absolute canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — project URL + anon key. Anon key is PUBLIC by design (RLS-gated).
# Get these from https://app.supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — site key (public). Register a site at
# https://dash.cloudflare.com → Turnstile → Add site. Use "Managed" mode.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Origin of the API Worker (e.g. https://api-dev.summit-mvp.workers.dev).
# Set after `wrangler deploy` of workers/turnstile-verify.
NEXT_PUBLIC_WORKER_ORIGIN=
